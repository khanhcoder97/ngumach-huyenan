<?xml version="1.0" encoding="utf-8"?>
<!-- Offline restore: nuget.org through this VM's egress proxy timed out on
     the first attempt (15 min, service index unreachable), while Godot ships
     every package it needs. Local source only = deterministic builds here.
     For a production switch, keep this vendored folder in the repo. -->
<configuration>
  <packageSources>
    <clear />
    <add key="godot-local" value="../nuget-local" />
  </packageSources>
</configuration>
