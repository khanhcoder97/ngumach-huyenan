; Engine configuration file.
; Ngũ Mạch — Huyền Ấn: Godot .NET prototype to evaluate a full switch from Unity.
; Locked visual standard carried over: 640x360 logical, 20 px per world unit, nearest filter.

config_version=5

[application]

config/icon="res://icon.svg"

config/name="NgumachPrototype"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "C#", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[dotnet]

project/assembly_name="NgumachPrototype"

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.16, 0.23, 0.35, 1)
