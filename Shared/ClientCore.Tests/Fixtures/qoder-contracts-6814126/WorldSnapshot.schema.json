{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/WorldSnapshot.schema.json",
  "title": "P1 authoritative world snapshot payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapId",
    "serverTick",
    "revision",
    "serverTimeUtc",
    "self",
    "entities"
  ],
  "properties": {
    "mapId": {
      "type": "string",
      "pattern": "^MAP_[A-Z0-9_]+$"
    },
    "serverTick": {
      "type": "integer",
      "minimum": 0
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "serverTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "self": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterId",
        "classId",
        "x",
        "y",
        "hp",
        "maxHp",
        "mp",
        "maxMp",
        "swordIntent"
      ],
      "properties": {
        "characterId": {
          "type": "string",
          "pattern": "^CHR_[A-Z0-9_]+$"
        },
        "classId": {
          "type": "string",
          "pattern": "^CLASS_[A-Z0-9_]+$"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "hp": {
          "type": "integer",
          "minimum": 0
        },
        "maxHp": {
          "type": "integer",
          "minimum": 1
        },
        "mp": {
          "type": "integer",
          "minimum": 0
        },
        "maxMp": {
          "type": "integer",
          "minimum": 0
        },
        "swordIntent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entityId",
          "kind",
          "x",
          "y",
          "hp",
          "maxHp",
          "state"
        ],
        "properties": {
          "entityId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "MOB",
              "ELITE",
              "BOSS",
              "NPC"
            ]
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "hp": {
            "type": "integer",
            "minimum": 0
          },
          "maxHp": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "IDLE",
              "CHASE",
              "ATTACK",
              "DEAD"
            ]
          },
          "telegraphId": {
            "type": "string",
            "pattern": "^TELEGRAPH_[A-Z0-9_]+$"
          }
        }
      }
    }
  }
}
