{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/InventoryV2Response.schema.json",
  "title": "P1 v2 inventory read/equip/unequip response",
  "description": "On success result is the committed v2 snapshot (the same payload as InventorySnapshotV2). On rejection error explains the reason and result may carry the current snapshot for revision_conflict and slot_occupied. Requests rejected before a session resolves omit sessionId and result. The route set exists only while P1:AlphaProfile is enabled; with the gate off it is not mapped and the pipeline answers 404.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "serverTimeUtc"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "serverTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "result": {
      "$ref": "InventorySnapshotV2.schema.json"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "messageKey",
        "retryable",
        "fieldErrors",
        "correlationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_payload",
            "session_not_found",
            "item_not_found",
            "wrong_location",
            "slot_occupied",
            "class_restricted",
            "level_required",
            "not_equippable",
            "revision_conflict",
            "idempotency_conflict"
          ]
        },
        "messageKey": {
          "type": "string",
          "pattern": "^P1\\.ERROR\\.[A-Z_]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correlationId": {
          "type": "string"
        }
      }
    }
  }
}
