{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/TurnInRequest.schema.json",
  "title": "P1 quest turn-in request payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "questId",
    "npcId"
  ],
  "properties": {
    "questId": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{2}$"
    },
    "npcId": {
      "type": "string",
      "pattern": "^NPC_[A-Z0-9_]+$"
    }
  }
}