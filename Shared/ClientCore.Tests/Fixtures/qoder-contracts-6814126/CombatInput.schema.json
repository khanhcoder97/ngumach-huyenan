{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/CombatInput.schema.json",
  "title": "P1 combat input payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputSequence",
    "skillId",
    "aimX",
    "aimY"
  ],
  "properties": {
    "inputSequence": {
      "type": "integer",
      "minimum": 1
    },
    "skillId": {
      "type": "string",
      "pattern": "^SK-MK-0[1-3]$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "aimX": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "aimY": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "clientTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
