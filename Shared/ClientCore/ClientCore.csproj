<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>NguMach.Client.Core</RootNamespace>
    <AssemblyName>NguMach.Client.Core</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>NguMach.Client.Core</PackageId>
    <Version>0.2.0-alpha.1</Version>
    <Authors>NguMach</Authors>
    <Company>NguMach</Company>
    <Description>Engine-agnostic P1 client core for the Godot client (session composition, typed contracts, presenters). Production gates remain OFF.</Description>
    <PackageTags>ngumach;godot;p1;client-core</PackageTags>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/khanhcoder97/ngumach-huyenan.git</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NguMach.Client.Core.Tests" />
  </ItemGroup>

  <!-- Reuse the existing portable Core/Presentation sources by explicit include (provenance kept). -->
  <ItemGroup>
    <Compile Include="../../Client/Assets/Scripts/Online/Core/*.cs" />
    <Compile Include="../../Client/Assets/Scripts/Online/Presentation/*.cs" />
  </ItemGroup>

  <!-- New Godot-portable additions live next to this csproj. -->
  <ItemGroup>
    <Compile Include="Encounter/*.cs" />
    <Compile Include="Guards/*.cs" />
    <Compile Include="Catalog/*.cs" />
    <Compile Include="Transport/*.cs" />
    <Compile Include="Dispatch/*.cs" />
    <Compile Include="Handshake/*.cs" />
    <Compile Include="Composition/*.cs" />
    <Compile Include="Tutorial/*.cs" />
  </ItemGroup>

</Project>
