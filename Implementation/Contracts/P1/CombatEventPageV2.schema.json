{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/CombatEventPageV2.schema.json",
  "title": "P1 v2 combat event page with monotonic cursor and explicit resync",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sessionId",
    "nextCursor",
    "resyncRequired",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "nextCursor": {
      "type": "integer",
      "minimum": 0
    },
    "resyncRequired": {
      "type": "boolean"
    },
    "resyncReason": {
      "type": "string",
      "enum": [
        "CURSOR_TOO_OLD",
        "BUFFER_OVERFLOW"
      ]
    },
    "events": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "cursor",
          "type",
          "castId",
          "actorId",
          "mapInstanceId",
          "floorId",
          "sourceRevision",
          "serverTick",
          "emittedAtUtc"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "cursor": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "CAST_START",
              "COUNTER_CONFIRMED",
              "IMPACT",
              "MISS",
              "CANCEL",
              "END",
              "DEATH"
            ]
          },
          "castId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "actorId": {
            "type": "string",
            "pattern": "^CHR_[A-Z0-9_]+$"
          },
          "targetId": {
            "type": "string",
            "pattern": "^ENT_[A-Z0-9_]+$"
          },
          "targetLifeId": {
            "type": "integer",
            "minimum": 1
          },
          "hitIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "mapInstanceId": {
            "type": "string",
            "pattern": "^MAP_[A-Z0-9_]+#[0-9]+$"
          },
          "floorId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "sourceRevision": {
            "type": "integer",
            "minimum": 0
          },
          "targetRevision": {
            "type": "integer",
            "minimum": 0
          },
          "serverTick": {
            "type": "integer",
            "minimum": 0
          },
          "emittedAtUtc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "result": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hit",
              "crit",
              "immune",
              "amount",
              "absorbed",
              "hpDamage"
            ],
            "properties": {
              "hit": {
                "type": "boolean"
              },
              "crit": {
                "type": "boolean"
              },
              "immune": {
                "type": "boolean"
              },
              "amount": {
                "type": "integer",
                "minimum": 0
              },
              "absorbed": {
                "type": "integer",
                "minimum": 0
              },
              "hpDamage": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    }
  }
}
