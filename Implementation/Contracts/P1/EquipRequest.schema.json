{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/EquipRequest.schema.json",
  "title": "P1 equip request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "sentAtUtc",
    "characterId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sentAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "characterId": {
      "type": "string",
      "pattern": "^CHR_[A-Z0-9_]+$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "itemInstanceId",
        "expectedRevision"
      ],
      "properties": {
        "itemInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
