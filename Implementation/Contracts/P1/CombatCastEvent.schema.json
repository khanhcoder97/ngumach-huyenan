{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/CombatCastEvent.schema.json",
  "title": "P1 combat cast lifecycle event",
  "description": "Versioned lifecycle event for VFX adapters. Separate from the legacy CombatEvent; emitted only once a server path implements the lifecycle.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "castId",
    "eventType",
    "mapId",
    "floorId",
    "sourceId",
    "skillId",
    "serverTick",
    "emittedAtUtc",
    "revision"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "castId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "eventType": {
      "type": "string",
      "enum": ["CAST_START", "CAST_IMPACT", "CAST_END", "CAST_CANCEL"]
    },
    "mapId": {
      "type": "string",
      "pattern": "^MAP_[A-Z0-9_]+$"
    },
    "floorId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^(CHR|ENT)_[A-Z0-9_]+$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^(CHR|ENT)_[A-Z0-9_]+$"
    },
    "groundXWu": {
      "type": "number"
    },
    "groundYWu": {
      "type": "number"
    },
    "skillId": {
      "type": "string",
      "pattern": "^SK-MK-0[1-3]$"
    },
    "serverTick": {
      "type": "integer",
      "minimum": 0
    },
    "emittedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "type": "string",
      "enum": ["hit", "miss", "blocked"]
    },
    "vfxKey": {
      "type": "string",
      "minLength": 1
    }
  }
}
