{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/QuestAcceptResponse.schema.json",
  "title": "P1 quest accept response",
  "description": "On success and on every post-resolution rejection, result carries the current QuestState; error explains a rejection. Requests rejected before the session or quest resolves (invalid payload, unknown session) may omit result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "sessionId",
    "serverTimeUtc"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "serverTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questId",
        "state",
        "stepId",
        "objectiveCounters",
        "revision"
      ],
      "properties": {
        "questId": {
          "type": "string",
          "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{2}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "LOCKED",
            "AVAILABLE",
            "ACTIVE",
            "READY_TO_TURN_IN",
            "COMPLETED",
            "FAILED"
          ]
        },
        "stepId": {
          "type": "string",
          "pattern": "^STEP_[A-Z0-9_]+$"
        },
        "objectiveCounters": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "messageKey",
        "retryable",
        "fieldErrors",
        "correlationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_payload",
            "session_not_found",
            "quest_not_found",
            "npc_mismatch",
            "out_of_range",
            "prerequisite_not_met",
            "invalid_transition",
            "revision_conflict",
            "idempotency_conflict"
          ]
        },
        "messageKey": {
          "type": "string",
          "pattern": "^P1\\.ERROR\\.[A-Z_]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\[\\]]+$"
          }
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
