{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/CombatEvent.schema.json",
  "title": "P1 combat event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "aggregateId",
    "aggregateRevision",
    "emittedAtUtc",
    "schemaVersion",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "combat.hit",
        "combat.effect",
        "combat.cooldown",
        "combat.death"
      ]
    },
    "aggregateId": {
      "type": "string",
      "pattern": "^CHR_[A-Z0-9_]+$"
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "emittedAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "targetId"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^CHR_[A-Z0-9_]+$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "skillId": {
          "type": "string",
          "pattern": "^SK-MK-0[1-3]$"
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "hit": {
          "type": "boolean"
        },
        "telegraphId": {
          "type": "string",
          "pattern": "^TELEGRAPH_[A-Z0-9_]+$"
        },
        "cooldownEndsAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      }
    }
  }
}
