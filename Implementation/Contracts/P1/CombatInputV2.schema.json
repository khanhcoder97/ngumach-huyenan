{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/CombatInputV2.schema.json",
  "title": "P1 v2 combat input payload (basic attack or active skill)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionKind",
    "inputSequence",
    "aimX",
    "aimY"
  ],
  "properties": {
    "actionKind": {
      "type": "string",
      "enum": [
        "BASIC_ATTACK",
        "SKILL"
      ]
    },
    "skillId": {
      "type": "string",
      "pattern": "^SK-MK-0[1-3]$"
    },
    "targetId": {
      "type": "string",
      "pattern": "^ENT_[A-Z0-9_]+$"
    },
    "inputSequence": {
      "type": "integer",
      "minimum": 1
    },
    "aimX": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "aimY": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "clientTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
