{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/UnequipV2Request.schema.json",
  "title": "P1 v2 unequip request",
  "description": "Posted to POST /p1/inventory/v2/unequip. slotId is one of the twelve tokens; emptying an empty slot is rejected wrong_location. The v1 unequip route and its five-token vocabulary are unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "idempotencyKey",
    "sentAtUtc",
    "characterId",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sentAtUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "characterId": {
      "type": "string",
      "pattern": "^CHR_[A-Z0-9_]+$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slotId",
        "expectedRevision"
      ],
      "properties": {
        "slotId": {
          "type": "string",
          "enum": [
            "HAT",
            "CHEST",
            "LEGS",
            "WEAPON",
            "GLOVES",
            "BOOTS",
            "NECK",
            "RING_L",
            "RING_R",
            "PENDANT",
            "CLOAK",
            "SEAL"
          ]
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
