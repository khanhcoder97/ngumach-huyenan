{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/EquipmentResponse.schema.json",
  "title": "P1 equip/unequip response",
  "description": "On success, result is the committed inventory snapshot (the same payload as InventorySnapshot). On rejection, error explains the reason and result may carry the current snapshot for revision_conflict and slot_occupied. Requests rejected before the session resolves omit sessionId and result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "serverTimeUtc"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "serverTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventoryRevision",
        "items",
        "currencies"
      ],
      "properties": {
        "inventoryRevision": {
          "type": "integer",
          "minimum": 0
        },
        "items": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "templateId",
              "stack",
              "location",
              "durability",
              "version"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "pattern": "^ITM_[A-Z0-9_]+$"
              },
              "templateId": {
                "type": "string",
                "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
              },
              "stack": {
                "type": "integer",
                "minimum": 1
              },
              "location": {
                "type": "string",
                "enum": [
                  "BAG",
                  "EQUIPPED",
                  "BANK"
                ]
              },
              "slot": {
                "type": "string",
                "pattern": "^[A-Z_]+$"
              },
              "durability": {
                "type": "integer",
                "minimum": 0
              },
              "version": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "currencies": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "currencyId",
              "amount"
            ],
            "properties": {
              "currencyId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]+$"
              },
              "amount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "messageKey",
        "retryable",
        "fieldErrors",
        "correlationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_payload",
            "session_not_found",
            "item_not_found",
            "wrong_location",
            "slot_occupied",
            "class_restricted",
            "level_required",
            "not_equippable",
            "revision_conflict",
            "idempotency_conflict"
          ]
        },
        "messageKey": {
          "type": "string",
          "pattern": "^P1\\.ERROR\\.[A-Z_]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\[\\]-]+$"
          }
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
