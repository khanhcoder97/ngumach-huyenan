{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/contracts/p1/InteractResponse.schema.json",
  "title": "P1 world interact response",
  "description": "On success, result carries the server-verified interaction (claim or gather) plus the quest states whose revision changed. Requests rejected before the session resolves (invalid payload, unknown session) omit sessionId and result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "serverTimeUtc"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "serverTimeUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interactionId",
        "targetId",
        "recordId",
        "kind",
        "outcome",
        "targetState",
        "claimedAtUtc",
        "questUpdates"
      ],
      "properties": {
        "interactionId": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^ENT_[A-Z0-9_]+$"
        },
        "recordId": {
          "type": "string",
          "pattern": "^MAN-[A-Z0-9_-]+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "INTERACTABLE",
            "GATHER_NODE"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "collected",
            "gathered"
          ]
        },
        "targetState": {
          "type": "string",
          "enum": [
            "AVAILABLE",
            "DEPLETED"
          ]
        },
        "claimedAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "respawnAtUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "yield": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "itemId",
            "quantity"
          ],
          "properties": {
            "itemId": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9-]+$"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "questUpdates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "questId",
              "state",
              "stepId",
              "objectiveCounters",
              "revision"
            ],
            "properties": {
              "questId": {
                "type": "string",
                "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{2}$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "LOCKED",
                  "AVAILABLE",
                  "ACTIVE",
                  "READY_TO_TURN_IN",
                  "COMPLETED",
                  "FAILED"
                ]
              },
              "stepId": {
                "type": "string",
                "pattern": "^STEP_[A-Z0-9_]+$"
              },
              "objectiveCounters": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "messageKey",
        "retryable",
        "fieldErrors",
        "correlationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "invalid_payload",
            "session_not_found",
            "target_not_found",
            "invalid_target",
            "out_of_range",
            "target_not_available",
            "profession_level_insufficient",
            "idempotency_conflict"
          ]
        },
        "messageKey": {
          "type": "string",
          "pattern": "^P1\\.ERROR\\.[A-Z_]+$"
        },
        "retryable": {
          "type": "boolean"
        },
        "fieldErrors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.\\[\\]-]+$"
          }
        },
        "correlationId": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
