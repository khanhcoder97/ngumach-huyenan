{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/schemas/content-pipeline/item_reference.schema.json",
  "title": "Item reward reference proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "referenceId",
    "questId",
    "sourceToken",
    "resolution"
  ],
  "properties": {
    "referenceId": {
      "type": "string",
      "pattern": "^ITEM_REF_[A-Z0-9_]+$"
    },
    "questId": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{2}$"
    },
    "sourceToken": {
      "type": "string",
      "minLength": 1
    },
    "resolution": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "CLASS_CONDITIONAL"
      ]
    },
    "resolvedItemId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
    },
    "category": {
      "type": "string",
      "enum": [
        "EQUIPMENT_WEAPON",
        "EQUIPMENT_ARMOR",
        "EQUIPMENT_ACCESSORY",
        "CONSUMABLE",
        "MATERIAL",
        "QUEST",
        "COSMETIC",
        "TOOL",
        "CURRENCY",
        "RECIPE",
        "PET",
        "MOUNT"
      ]
    },
    "catalogSlotVi": {
      "type": "string",
      "minLength": 1
    },
    "requiredLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "rarity": {
      "type": "string",
      "enum": [
        "COMMON",
        "REFINED",
        "SPIRIT",
        "ARCANE",
        "RELIC",
        "FIXED"
      ]
    },
    "candidateItemIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9_-]+$"
      }
    },
    "classCandidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "classId",
          "itemId"
        ],
        "properties": {
          "classId": {
            "type": "string",
            "pattern": "^CLASS_[A-Z_]+$"
          },
          "itemId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
