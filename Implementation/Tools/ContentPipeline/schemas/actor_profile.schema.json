{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/schemas/content-pipeline/actor_profile.schema.json",
  "title": "Actor base profile proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profileId",
    "level",
    "mapId",
    "attributes",
    "derived",
    "formulas",
    "equipment",
    "classSkillReferences"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "pattern": "^ACTOR_[A-Z0-9_]+$"
    },
    "level": {
      "type": "integer",
      "const": 1
    },
    "mapId": {
      "type": "string",
      "pattern": "^MAP_[A-Z0-9_]+$"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STR", "INT", "AGI", "VIT", "LUK"],
      "properties": {
        "STR": {"type": "integer", "const": 5},
        "INT": {"type": "integer", "const": 5},
        "AGI": {"type": "integer", "const": 5},
        "VIT": {"type": "integer", "const": 5},
        "LUK": {"type": "integer", "const": 5}
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxHp", "maxMp", "physicalAttack", "magicAttack", "armor"],
      "properties": {
        "maxHp": {"type": "integer", "const": 198},
        "maxMp": {"type": "integer", "const": 102},
        "physicalAttack": {"type": "integer", "const": 20},
        "magicAttack": {"type": "integer", "const": 20},
        "armor": {"type": "integer", "const": 10}
      }
    },
    "formulas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxHp", "maxMp", "physicalAttack", "magicAttack", "armor"],
      "properties": {
        "maxHp": {"type": "string", "minLength": 1},
        "maxMp": {"type": "string", "minLength": 1},
        "physicalAttack": {"type": "string", "minLength": 1},
        "magicAttack": {"type": "string", "minLength": 1},
        "armor": {"type": "string", "minLength": 1}
      }
    },
    "equipment": {
      "type": "array",
      "maxItems": 0
    },
    "classSkillReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classId", "startingSkillIds"],
        "properties": {
          "classId": {
            "type": "string",
            "pattern": "^CLASS_[A-Z0-9_]+$"
          },
          "startingSkillIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^SK-[A-Z0-9-]+$"
            }
          }
        }
      }
    }
  }
}
