{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ngũ Mạch Huyền Ấn Asset Delivery Manifest",
  "type": "object",
  "required": ["assetPackId", "assetPackVersion", "owner", "sourceLicense", "assets"],
  "properties": {
    "assetPackId": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "assetPackVersion": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"const": "Muse"},
    "sourceLicense": {"const": "original"},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assetId", "path", "kind", "status", "pixelWidth", "pixelHeight", "pixelsPerUnit", "previewPath"],
        "properties": {
          "assetId": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "path": {"type": "string", "pattern": "^Client/Assets/"},
          "kind": {"enum": ["sprite", "sprite_sheet", "tileset", "tilemap", "ui_texture", "vfx_sheet", "animation", "icon"]},
          "status": {"enum": ["draft", "approved", "deprecated"]},
          "pixelWidth": {"type": "integer", "minimum": 1},
          "pixelHeight": {"type": "integer", "minimum": 1},
          "pixelsPerUnit": {"const": 20},
          "pivot": {"type": "string"},
          "tileSize": {"type": "string"},
          "directions": {"type": "array", "items": {"enum": ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]}},
          "animations": {"type": "array", "items": {"type": "object"}},
          "previewPath": {"type": "string"},
          "replacesAssetId": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
