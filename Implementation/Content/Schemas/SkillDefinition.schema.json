{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/schemas/SkillDefinition.schema.json",
  "title": "SkillDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skillId",
    "classId",
    "displayNameKey",
    "cooldownSeconds",
    "resourceCost",
    "targeting",
    "coefficients",
    "telegraphSeconds",
    "vfxKey",
    "sourceRef"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "skillId": {
      "type": "string",
      "pattern": "^SK-[A-Z0-9]{2}-[0-9]{2}$"
    },
    "classId": {
      "type": "string",
      "pattern": "^CLASS_[A-Z0-9_]+$"
    },
    "displayNameKey": {
      "type": "string",
      "pattern": "^SKILL\\.[A-Z0-9-]+\\.[A-Z0-9_]+$"
    },
    "cooldownSeconds": {
      "type": "number",
      "minimum": 0
    },
    "resourceCost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "amount"],
      "properties": {
        "resource": {
          "type": "string",
          "enum": ["MP", "NONE"]
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "maxTargets"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["SELF", "ENEMY", "ALLY", "AREA", "LINE", "CONE", "DASH"]
        },
        "rangeWu": {
          "type": "number",
          "minimum": 0
        },
        "angleDegrees": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "maxTargets": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "coefficients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pve", "boss", "pvp"],
      "properties": {
        "pve": {
          "type": "number",
          "minimum": 0
        },
        "boss": {
          "type": "number",
          "minimum": 0
        },
        "pvp": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "telegraphSeconds": {
      "type": "number",
      "minimum": 0
    },
    "vfxKey": {
      "type": "string",
      "pattern": "^VFX/Skill/SK-[A-Z0-9]{2}-[0-9]{2}$"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
