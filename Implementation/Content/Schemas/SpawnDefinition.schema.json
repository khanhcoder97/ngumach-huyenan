{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/schemas/SpawnDefinition.schema.json",
  "title": "SpawnDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "mapId",
    "zoneId",
    "recordType",
    "designState",
    "spawnGroupId",
    "entityIds",
    "quantity",
    "composition",
    "position",
    "patrolRadiusWu",
    "levelBand",
    "respawnSeconds",
    "condition",
    "lootTableId",
    "sourceRef"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "recordId": {
      "type": "string",
      "pattern": "^MAN-[A-Z0-9]+-(SPAWN|EVENT|NODE|NPC|INTERACT)_[A-Z0-9_]+$"
    },
    "mapId": {
      "type": "string",
      "pattern": "^MAP_[A-Z0-9_]+$"
    },
    "zoneId": {
      "type": "string",
      "minLength": 1
    },
    "recordType": {
      "type": "string",
      "enum": ["MOB_GROUP", "BOSS"]
    },
    "designState": {
      "type": "string",
      "enum": [
        "ATLAS_ANCHOR",
        "ATLAS_QUEST_WAVE",
        "ACTIVITY_PLACEMENT",
        "ATLAS_SPAWN",
        "ATLAS_EVENT_POOL",
        "ATLAS_BOSS",
        "ACTIVITY_BOSS",
        "ATLAS_QUEST_ACTOR",
        "NEW_PROPOSED",
        "REPLACED",
        "CUT"
      ]
    },
    "spawnGroupId": {
      "type": "string",
      "pattern": "^SPAWN_[A-Z0-9_]+$"
    },
    "entityIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      }
    },
    "quantity": {
      "type": "integer",
      "minimum": 1
    },
    "composition": {
      "type": "string",
      "minLength": 1
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xWu", "yWu"],
      "properties": {
        "xWu": {
          "type": "number"
        },
        "yWu": {
          "type": "number"
        }
      }
    },
    "patrolRadiusWu": {
      "type": "number",
      "minimum": 0
    },
    "levelBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "respawnSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "lootTableId": {
      "type": "string",
      "pattern": "^(LT_[A-Z0-9_]+|NONE)$"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
