{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/schemas/MapTopology.schema.json",
  "title": "MapTopology",
  "description": "Top-down walkability/blocking bundle for one map (DEC-016). reviewState REVIEWED is required before the server enforces line-of-sight.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mapId",
    "layoutVersion",
    "bundleVersion",
    "coordinateSystem",
    "reviewState",
    "bounds",
    "floorIds",
    "walkablePolygons",
    "blockedPolygons",
    "placements",
    "sourceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "mapId": {
      "type": "string",
      "pattern": "^MAP_[A-Z0-9_]+$"
    },
    "layoutVersion": {
      "type": "integer",
      "minimum": 1
    },
    "bundleVersion": {
      "type": "integer",
      "minimum": 1
    },
    "coordinateSystem": {
      "type": "string",
      "const": "TOP_DOWN_XY"
    },
    "reviewState": {
      "type": "string",
      "enum": ["REVIEWED", "SYNTHETIC_TEST_ONLY"]
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xMin", "xMax", "yMin", "yMax"],
      "properties": {
        "xMin": { "type": "number" },
        "xMax": { "type": "number" },
        "yMin": { "type": "number" },
        "yMax": { "type": "number" }
      }
    },
    "floorIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "walkablePolygons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floorId", "points"],
        "properties": {
          "floorId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["xWu", "yWu"],
              "properties": {
                "xWu": { "type": "number" },
                "yWu": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "blockedPolygons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["floorId", "points"],
        "properties": {
          "floorId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["xWu", "yWu"],
              "properties": {
                "xWu": { "type": "number" },
                "yWu": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "placements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "npcId", "floorId", "xWu", "yWu"],
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^MAN-[A-Z0-9_-]+$"
          },
          "npcId": {
            "type": "string",
            "pattern": "^NPC_[A-Z0-9_]+$"
          },
          "floorId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "xWu": { "type": "number" },
          "yWu": { "type": "number" }
        }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
