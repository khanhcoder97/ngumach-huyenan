{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngumach.local/schemas/ClassDefinition.schema.json",
  "title": "ClassDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "classId",
    "displayNameKey",
    "element",
    "role",
    "weaponType",
    "startingSkillIds",
    "assetKey",
    "sourceRef"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "classId": {
      "type": "string",
      "pattern": "^CLASS_[A-Z0-9_]+$"
    },
    "displayNameKey": {
      "type": "string",
      "pattern": "^CLASS\\.[A-Z0-9_]+\\.[A-Z0-9_]+$"
    },
    "element": {
      "type": "string",
      "enum": ["KIM", "MOC", "THUY", "HOA", "THO"]
    },
    "role": {
      "type": "string",
      "enum": ["MELEE_FLEX", "MELEE_BURST", "RANGED_MAGIC", "TANK", "RANGED_PHYSICAL"]
    },
    "weaponType": {
      "type": "string",
      "enum": ["SWORD", "SABER", "BRUSH", "HAMMER", "BOW"]
    },
    "startingSkillIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SK-[A-Z0-9]{2}-[0-9]{2}$"
      }
    },
    "assetKey": {
      "type": "string",
      "pattern": "^Art/Characters/CLASS_[A-Z0-9_]+$"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    }
  }
}
