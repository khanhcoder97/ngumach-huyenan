  "dialogue": [
    {
      "quest_id": "P00-01",
      "quest_title_vi": "Thư qua bến",
      "node_type": "OFFER",
      "speaker_id": "NPC_LYAN",
      "text_key": "DLG_P00_01_OFFER_TEXT",
      "text_vi": "Giữ giúp tôi đầu dây này! Ba kiện hàng vừa trôi dạt quanh bến. Đưa chúng cùng lá thư còn niêm sáp này tới Tạ Vân Khanh. Người nhận vẫn đang đợi."
    },
    {
      "quest_id": "P00-01",
      "quest_title_vi": "Thư qua bến",
      "node_type": "CLUE",
      "speaker_id": "NPC_LYAN",
      "text_key": "DLG_P00_01_CLUE_TEXT",
      "text_vi": "Kiện buộc nút đôi, kiện quấn vải và kiện có dấu mực — đừng bỏ sót cái nào. Còn lá thư, xin giữ nguyên niêm. Có những lời phải tới đúng người trước đã."
    },
    {
      "quest_id": "P00-01",
      "quest_title_vi": "Thư qua bến",
      "node_type": "TURN_IN",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_01_TURN_IN_TEXT",
      "text_vi": "Ba kiện đều còn. Tốt. Niêm sáp này có năm vạch... ta đã thấy một dấu gần như thế. Cứ để thư ở đây; ta sẽ kiểm tra người gửi."
    },
    {
      "quest_id": "P00-02",
      "quest_title_vi": "Chuông không người",
      "node_type": "OFFER",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_02_OFFER_TEXT",
      "text_vi": "Trên bờ không ai nghe chuông, nhưng mặt nước cứ rung đúng một nhịp. Hãy kiểm tra ba chỗ nước gợn và hạ bốn Cá Linh quanh đó, rồi quay lại nói điều ngươi thấy."
    },
    {
      "quest_id": "P00-02",
      "quest_title_vi": "Chuông không người",
      "node_type": "CLUE",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_02_CLUE_TEXT",
      "text_vi": "Đừng chỉ chờ tiếng chuông. Nhìn những vòng nước: chúng co vào tâm thay vì tản ra. So cả ba chỗ rồi hãy kết luận; một dấu lạ chưa đủ làm bằng chứng."
    },
    {
      "quest_id": "P00-02",
      "quest_title_vi": "Chuông không người",
      "node_type": "TURN_IN",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_02_TURN_IN_TEXT",
      "text_vi": "Cả ba nơi cùng một nhịp, mà trên bờ vẫn im. Vậy thứ rung không nằm trong không khí. Ta chưa biết ai đánh chuông — cũng chưa chắc đó là một chiếc chuông."
    },
    {
      "quest_id": "P00-03",
      "quest_title_vi": "Dưới mặt đầm",
      "node_type": "OFFER",
      "speaker_id": "NPC_LYAN",
      "text_key": "DLG_P00_03_OFFER_TEXT",
      "text_vi": "Hai người còn kẹt dưới đầm! Phá ba đám Rễ Nước trước, rồi tới giúp từng người. Khi mặt nước dồn lại thành sóng, tránh ra chỗ trống; đừng cố đứng chịu."
    },
    {
      "quest_id": "P00-03",
      "quest_title_vi": "Dưới mặt đầm",
      "node_type": "CLUE",
      "speaker_id": "NPC_LYAN",
      "text_key": "DLG_P00_03_CLUE_TEXT",
      "text_vi": "Một người bảo đã thấy bóng ai giống bạn dưới nước. Người kia lại nhớ một khuôn mặt khác. Cứ đưa họ lên bờ đã; lúc sợ hãi, ký ức không chịu đứng yên."
    },
    {
      "quest_id": "P00-03",
      "quest_title_vi": "Dưới mặt đầm",
      "node_type": "TURN_IN",
      "speaker_id": "NPC_LYAN",
      "text_key": "DLG_P00_03_TURN_IN_TEXT",
      "text_vi": "Cả hai đã lên bờ. Tôi hỏi lại, họ vẫn kể khác nhau. Có lẽ nên giữ cả hai lời kể... ít nhất đừng bắt một người nhận rằng mình đã nhìn sai."
    },
    {
      "quest_id": "P00-04",
      "quest_title_vi": "Người giữ bờ",
      "node_type": "OFFER",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_04_OFFER_TEXT",
      "text_vi": "Ly An sẽ men bờ tới Đầm Chuông. Đi cùng cô ấy, giữ hai chặng nghỉ và đẩy lùi hai đợt quái, mỗi đợt ba con. Nếu phải lui, tập hợp lại ở chặng vừa giữ được."
    },
    {
      "quest_id": "P00-04",
      "quest_title_vi": "Người giữ bờ",
      "node_type": "CLUE",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_04_CLUE_TEXT",
      "text_vi": "Đừng thúc Ly An đi tiếp khi đường còn quái. Nếu niêm sáp rạn thêm, đừng chạm vào nó. Hãy để cô ấy mang thư qua bờ; ta muốn biết ở đâu dấu sáp còn yên."
    },
    {
      "quest_id": "P00-04",
      "quest_title_vi": "Người giữ bờ",
      "node_type": "TURN_IN",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_04_TURN_IN_TEXT",
      "text_vi": "Ly An đã qua, thư cũng còn đây. Vết rạn dừng ngay mép dấu thứ năm. Ta biết ngươi muốn hỏi gì... hãy cho ta nhìn lại nó một lần nữa."
    },
    {
      "quest_id": "P00-05",
      "quest_title_vi": "Mảnh ấn đầu tiên",
      "node_type": "OFFER",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_05_OFFER_TEXT",
      "text_vi": "Mãng Cốt đang quẫy ở Đầm Chuông. Vào vòng đầm, vượt qua nó rồi kiểm tra mảnh lộ dưới nước. Khi trở về, gặp quan sát viên để xác nhận môn phái ngươi đã chọn."
    },
    {
      "quest_id": "P00-05",
      "quest_title_vi": "Mảnh ấn đầu tiên",
      "node_type": "CLUE",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_05_CLUE_TEXT",
      "text_vi": "Đừng nhìn những vệt sáng trên thân nó mà quên mặt nước dưới chân. Khi đầm yên, hãy tự kiểm tra vật vừa lộ ra. Ta không muốn đặt tên cho điều ngươi chưa thấy."
    },
    {
      "quest_id": "P00-05",
      "quest_title_vi": "Mảnh ấn đầu tiên",
      "node_type": "TURN_IN",
      "speaker_id": "NPC_TA_VAN_KHANH",
      "text_key": "DLG_P00_05_TURN_IN_TEXT",
      "text_vi": "“Huyền Ấn”... ngươi cũng đọc được hai chữ ấy. Ta còn một chuyện chưa thể kể vội. Khi việc ở bến đã khép lại, hãy tới Thanh Lạc. Mang theo điều đã thấy, cả những điều ta chưa giải thích."
    }
  ],
