# Large binary assets: requires `git lfs install` before adding files.
*.png filter=lfs diff=lfs merge=lfs -text
*.aseprite filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.ogv filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text

# Stable textual provenance for the authored audio generator and music scores.
Tools/AudioProduction/*.py text eol=lf
Tools/AudioProduction/requirements.txt text eol=lf
Art_Source/Audio/*.json text eol=lf
Art_Source/Audio/Scores/*.json text eol=lf

# Review-only candidate artifacts are byte deterministic on Windows and Linux.
Implementation/Content/BuildCandidates/**/*.json text eol=lf
Implementation/Tools/ContentPipeline/*.json text eol=lf
Implementation/Tools/ContentPipeline/schemas/*.json text eol=lf
Implementation/Tools/MuseMapAdapter/fixtures/*.json text eol=lf
Implementation/Tools/MuseMapAdapter/schemas/*.json text eol=lf

# Media delivery SHA256 is over UTF-8 LF bytes on every checkout/platform.
Art_Source/Cinematics/**/*.json text eol=lf
Art_Source/Audio/Muse/**/*.json text eol=lf
Implementation/Content/Narrative/Deliveries/**/*.json text eol=lf
Implementation/Content/Narrative/Deliveries/**/*.srt text eol=lf
ClientGodot/assets/cinematics/**/*.json text eol=lf
ClientGodot/assets/cinematics/**/*.srt text eol=lf
ClientGodot/assets/audio/**/*.json text eol=lf
